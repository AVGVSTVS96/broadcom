{
  "name": "broadcom-monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*"
    ],
    "catalog": {
      "@types/bun": "1.4.4",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --check && bun --filter '*' typecheck && bun --filter '*' test && cargo fmt --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "fix": "oxlint --fix; oxfmt; cargo fmt",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "catalog:",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.3"
}
